post_install() {
    # Initialise the image store and pelagos group.
    /usr/share/pelagos/setup.sh --no-user

    echo ""
    echo "==> pelagos installed."
    echo ""
    echo "    Add yourself to the pelagos group to pull images without sudo:"
    echo "      sudo usermod -aG pelagos \$USER"
    echo "    Then log out and back in (or run 'newgrp pelagos' in this shell)."
    echo ""
    echo "    Quick start:"
    echo "      pelagos image pull alpine"
    echo "      pelagos run alpine /bin/echo hello"
    echo ""
    echo "    Kubernetes (CRI) and Kata Containers / gVisor are optional. To use them:"
    echo "      1. sudo systemctl enable --now pelagos-cri        # CRI socket /run/pelagos/cri.sock"
    echo "      2. install Kata (tree at /opt/kata) and/or gVisor (runsc + shim in /usr/local/bin)"
    echo "      3. sudo pelagos-cri-shim-handlers add kata=/opt/kata/bin/containerd-shim-kata-v2"
    echo "      4. pelagos-cri-shim-handlers runtimeclass kata   # RuntimeClass objects, needs kubectl"
    echo "    Full steps: /usr/share/doc/pelagos/SHIM_HANDLERS_GUIDE.md"
}

post_upgrade() {
    # Re-run setup to repair any permissions that may have drifted.
    /usr/share/pelagos/setup.sh --no-user
}
