# /etc/pelagos/cri.env — optional settings for pelagos-cri.service.
# Copy this file to /etc/pelagos/cri.env (or let
# `pelagos-cri-shim-handlers add NAME=BINARY` write it) and restart
# pelagos-cri. With no file, or PELAGOS_CRI_ARGS empty, pods run natively.

# Extra pelagos-cri flags. Each --shim-handler NAME=BINARY makes the
# Kubernetes RuntimeClass whose `handler` is NAME run pods through that
# containerd shim v2 binary (Kata micro-VMs, gVisor).
#PELAGOS_CRI_ARGS="--shim-handler kata=/opt/kata/bin/containerd-shim-kata-v2 --shim-handler gvisor=/usr/local/bin/containerd-shim-runsc-v1"

# Shims are exec'd with pelagos-cri's PATH; gVisor's shim finds `runsc` here.
# Override only if runsc/qemu live outside the default.
#PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
