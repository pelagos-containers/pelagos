; The second service cannot start (its command does not exist). `compose up` must say so,
; exit non-zero, and leave nothing behind (the first service is rolled back).
(compose-up
  (compose
    (service "first"
      '(image "alpine:3.20")
      '(command "sleep" "3600"))
    (service "broken"
      '(image "alpine:3.20")
      '(command "/no/such/binary")
      (list 'depends-on "first"))))
